# Copy to .env.local and fill in real values. Never commit .env.local
#
# Token validation: API_TOKEN is checked against a SharePoint list in Power Automate.
# On leak: rotate BOTH the SharePoint list entry AND this file (and FLOW_URL if regenerated).
#
# Never put these values in frontend code, Git, or screenshots.

FLOW_URL=PASTE_FULL_HTTP_TRIGGER_URL_HERE
API_TOKEN=MEIN_SECRET_TOKEN
